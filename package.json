{
  "name": "frida-swift-bridge",
  "version": "4.0.0-preview.1",
  "description": "Swift runtime interop from Frida",
  "keywords": [
    "frida-gum",
    "frida-gum-bridge"
  ],
  "license": "MIT",
  "author": "Håvard Sørbø",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./abi": {
      "types": "./dist/abi.d.ts",
      "import": "./dist/abi.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "pretest": "sh tests/fixtures/build.sh",
    "test": "injest",
    "pretest:v8": "sh tests/fixtures/build.sh",
    "test:v8": "injest --target local-v8",
    "pretest:macos-arm64e": "ARCH=arm64e sh tests/fixtures/build.sh",
    "test:macos-arm64e": "injest --target macos-arm64e",
    "pretest:ios": "PLATFORM=ios EMBED_FIXTURES=1 sh tests/fixtures/build.sh",
    "test:ios": "injest --target ios",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@frida/injest": "^0.1.5",
    "@types/frida-gum": "^19.12.0",
    "@types/node": "^26.1.0",
    "frida": "^17.22.2",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "frida@17.22.2": true
  }
}
